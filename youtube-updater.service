[Unit]
Description=YouTube Dynamic Title & Views Automation Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/youtube-views
ExecStart=/opt/youtube-views/.venv/bin/python main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=SYNC_GITHUB_METRICS=false
Environment=METADATA_UPDATE_INTERVAL_SECONDS=3600
StandardOutput=append:/opt/youtube-views/automation.log
StandardError=append:/opt/youtube-views/automation.log

[Install]
WantedBy=multi-user.target
